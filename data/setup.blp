using Gtk 4.0;
using Adw 1;

template $EpolaSetupWindow : Adw.Window {
  modal: true;
  width-request: 520;
  height-request: 620;
  resizable: false;

  content: Box {
    orientation: vertical;

    Adw.HeaderBar {
      title-widget: Adw.ViewSwitcher {
        stack: setup_stack;
        policy: wide;
      };
    }

    Adw.ViewStack setup_stack {
      vexpand: true;

      Adw.ViewStackPage {
        name: "welcome";
        title: _("Bienvenida");
        child: Box {
          orientation: vertical;
          valign: center;
          spacing: 18;
          margin-top: 36;
          margin-bottom: 36;
          margin-start: 30;
          margin-end: 30;
          styles ["welcome-screen"]

          Label {
            label: _("Bienvenido a Epola");
            styles ["title-1"]
            wrap: true;
            justify: center;
          }

          Label {
            label: _("Configura tu tienda para Flatpak, Snap y paquetes nativos.");
            wrap: true;
            justify: center;
            styles ["dim-label"]
          }

          Button {
            label: _("Empezar");
            halign: center;
            styles ["suggested-action", "pill"]
            clicked => $on_next_clicked();
          }
        };
      }

      Adw.ViewStackPage {
        name: "theme";
        title: _("Tema");
        child: Box {
          orientation: vertical;
          valign: center;
          spacing: 18;
          margin-top: 36;
          margin-bottom: 36;
          margin-start: 30;
          margin-end: 30;

          Label {
            label: _("Elige tema");
            styles ["title-2"]
            halign: center;
          }

          Box {
            orientation: horizontal;
            halign: center;
            spacing: 24;

            Button {
              styles ["card"]
              clicked => $on_theme_light_clicked();
              Box {
                orientation: vertical;
                spacing: 8;
                margin-top: 14;
                margin-bottom: 14;
                margin-start: 14;
                margin-end: 14;
                Image {
                  icon-name: "weather-clear-symbolic";
                  pixel-size: 36;
                }
                Label { label: _("Claro"); }
              }
            }

            Button {
              styles ["card"]
              clicked => $on_theme_dark_clicked();
              Box {
                orientation: vertical;
                spacing: 8;
                margin-top: 14;
                margin-bottom: 14;
                margin-start: 14;
                margin-end: 14;
                Image {
                  icon-name: "weather-clear-night-symbolic";
                  pixel-size: 36;
                }
                Label { label: _("Oscuro"); }
              }
            }
          }

          Button {
            label: _("Siguiente");
            halign: center;
            styles ["suggested-action"]
            margin-top: 12;
            clicked => $on_next_clicked();
          }
        };
      }

      Adw.ViewStackPage {
        name: "features";
        title: _("Ajustes");
        child: Box {
          orientation: vertical;
          spacing: 12;
          margin-top: 24;
          margin-bottom: 24;
          margin-start: 24;
          margin-end: 24;

          Label {
            label: _("Configuración inicial");
            styles ["title-3"]
            halign: start;
          }

          Adw.ActionRow {
            title: _("Actualizaciones automáticas");
            subtitle: _("Revisar updates en segundo plano");
            Switch auto_updates_switch {
              valign: center;
            }
          }

          Adw.ActionRow {
            title: _("Activar PPA (experimental)");
            subtitle: _("Permite integrar repositorios adicionales");
            Switch ppa_switch {
              valign: center;
            }
          }

          Button {
            label: _("Finalizar");
            styles ["suggested-action"]
            margin-top: 20;
            clicked => $on_finish_clicked();
          }
        };
      }
    }
  };
}
